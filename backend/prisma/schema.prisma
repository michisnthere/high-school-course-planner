generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

//
// =========================
// DIVISION
// =========================
//
model Division {
  id             Int     @id @default(autoincrement())
  name           String  @unique
  normalizedName String?
  description    String?

  departments Department[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

//
// =========================
// DEPARTMENT
// =========================
//
model Department {
  id Int @id @default(autoincrement())

  name           String
  normalizedName String?
  description    String?

  divisionId Int
  division   Division @relation(fields: [divisionId], references: [id], onDelete: Cascade)

  courses Course[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([divisionId, name])
  @@index([divisionId])
}

//
// =========================
// COURSE
// =========================
//
model Course {
  id Int @id @default(autoincrement())

  title           String
  normalizedTitle String?

  importKey String @unique

  description String?

  duration Int?

  slotsPerSemester    Int     @default(1)
  attributes          Json    @default("[]")
  fulfillsRequirements Json   @default("[]")
  isRepeatable        Boolean @default(false)
  isMarchingBand      Boolean @default(false)

  notes           Json    @default("[]")
  sourceReference String?

  departmentId Int?
  department   Department? @relation(fields: [departmentId], references: [id], onDelete: SetNull)

  options          CourseOption[]
  requirements     CourseRequirement[]
  savedCourses     SavedCourse[]
  plannedCourses   PlannedCourse[]
  completedCourses CompletedCourse[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([departmentId, title])
  @@index([departmentId])
}

//
// =========================
// COURSE OPTION
// =========================
//
model CourseOption {
  id Int @id @default(autoincrement())

  name String

  isOnline        Boolean @default(false)
  creditType      String?
  credits         Float?
  gpaWaiverOption Boolean @default(false)

  attributes Json @default("[]")

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  offerings CourseOffering[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([courseId])
}

//
// =========================
// COURSE OFFERING
// =========================
//
model CourseOffering {
  id Int @id @default(autoincrement())

  courseCode String

  semesterLabel String?
  duration      String?

  gradeMin Int?
  gradeMax Int?

  prerequisites Json @default("[]")
  corequisites  Json @default("[]")

  creditType String?
  credits    Float?

  courseOptionId Int
  courseOption   CourseOption @relation(fields: [courseOptionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseOptionId, courseCode])
  @@index([courseOptionId])
  @@index([courseCode])
}

//
// =========================
// PLANNER OPTION
// =========================
//
model PlannerOption {
  id              Int      @id @default(autoincrement())
  name            String   @unique
  duration        Int      @default(1)
  credits         Int      @default(0)
  availableGrades Int[]    @default([])
  maxPerYear      Int?
  isNonAcademic   Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  plannedCourses PlannedCourse[]
}

//
// =========================
// GRADUATION REQUIREMENT
// =========================
//
model GraduationRequirement {
  id Int @id @default(autoincrement())

  name            String
  normalizedName  String?
  category        String?
  requirementType String?
  requiredValue   Float?
  gradeLevel      Int?    // 9-12 for year-specific requirements, null for graduation totals
  isMeasurable    Boolean @default(true)
  notes           Json    @default("[]")
  sourceReference String?

  courses CourseRequirement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, category, requirementType])
}

//
// =========================
// COURSE REQUIREMENT
// =========================
//
model CourseRequirement {
  id Int @id @default(autoincrement())

  courseId Int
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  graduationRequirementId Int
  graduationRequirement   GraduationRequirement @relation(fields: [graduationRequirementId], references: [id], onDelete: Cascade)

  @@unique([courseId, graduationRequirementId])
  @@index([courseId])
  @@index([graduationRequirementId])
}

//
// =========================
// USER
// =========================
//
model User {
  id        Int      @id @default(autoincrement())
  googleId  String   @unique
  email     String   @unique
  name      String?
  picture   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  savedCourses         SavedCourse[]
  planners             Planner[]
  completedCourses     CompletedCourse[]
  requirementResolutions RequirementResolution[]
}

//
// =========================
// SAVED COURSE
// =========================
//
model SavedCourse {
  id        Int      @id @default(autoincrement())
  userId    Int
  courseId  Int
  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

//
// =========================
// COMPLETED COURSE
// =========================
//
model CompletedCourse {
  id             Int      @id @default(autoincrement())
  userId         Int
  courseId       Int
  gradeCompleted String
  letterGrade    String?
  credits        Float?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@index([userId])
  @@index([courseId])
}

//
// =========================
// PLANNER
// =========================
//
model Planner {
  id         Int      @id @default(autoincrement())
  userId     Int
  schoolYear Int
  completedAt DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  plannedCourses PlannedCourse[]

  @@unique([userId, schoolYear])
  @@index([userId])
}

//
// =========================
// REQUIREMENT RESOLUTION
// =========================
//
model RequirementResolution {
  id        Int      @id @default(autoincrement())
  userId    Int
  type      String   // "pe_waiver" | "middle_school" | "summer_school" | "placement_test" | "admin_override"
  courseId  Int?     // optional course reference
  metadata  Json     @default("{}") // flexible payload for any resolution type
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([userId, type])
}

//
// =========================
// PLANNED COURSE
// =========================
//
model PlannedCourse {
  id              Int      @id @default(autoincrement())
  plannerId       Int
  courseId        Int?
  plannerOptionId Int?
  semester        Int
  slot            Int
  slotSpan        Int      @default(1) // 1 = one slot; 2 = occupies slot and slot+1, etc.
  createdAt       DateTime @default(now())

  planner       Planner        @relation(fields: [plannerId], references: [id], onDelete: Cascade)
  course        Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  plannerOption PlannerOption? @relation(fields: [plannerOptionId], references: [id], onDelete: Cascade)

  @@unique([plannerId, semester, slot])
  @@index([plannerId])
  @@index([courseId])
  @@index([plannerOptionId])
}
