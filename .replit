modules = ["python-3.12", "nodejs-20", "web", "nix"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "vm"
run = ["npm", "run", "import:courses"]

[userenv]

[userenv.shared]
FRONTEND_URL = "https://88346250-d454-4226-bbea-382fe7d012d2-00-1d8uuf6pzk16n.spock.replit.dev:3000"
NEXT_PUBLIC_API_URL = "https://88346250-d454-4226-bbea-382fe7d012d2-00-1d8uuf6pzk16n.spock.replit.dev"
BACKEND_URL = "https://88346250-d454-4226-bbea-382fe7d012d2-00-1d8uuf6pzk16n.spock.replit.dev"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && PORT=4000 npm run dev"
waitForPort = 4000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && PORT=3000 npm run dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 4000
externalPort = 80

[[ports]]
localPort = 9999
externalPort = 3001
