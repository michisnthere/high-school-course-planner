modules = ["python-3.12", "nodejs-20", "nix", "postgresql-16"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"

[nix]
channel = "stable-25_05"

[deployment]
deploymentTarget = "vm"
run = ["npm", "run", "import:courses"]

[[ports]]
localPort = 3000
externalPort = 3000

[[ports]]
localPort = 4000
externalPort = 80

[userenv]

[userenv.shared]
FRONTEND_URL = "https://3d4ec48d-9bea-4ab2-9623-a3ca48b2e753-00-2lyn05yaghqlq.riker.replit.dev"
NEXT_PUBLIC_API_URL = "https://3d4ec48d-9bea-4ab2-9623-a3ca48b2e753-00-2lyn05yaghqlq.riker.replit.dev:4000"
BACKEND_URL = "https://3d4ec48d-9bea-4ab2-9623-a3ca48b2e753-00-2lyn05yaghqlq.riker.replit.dev:4000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Backend"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Backend"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd backend && PORT=4000 npm run dev"
waitForPort = 4000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd frontend && PORT=3000 npm run dev"
waitForPort = 3000

[workflows.workflow.metadata]
outputType = "console"
